# Creative Commerce Studio — configuration NAMES only. Run `aio app use` first (it creates
# .env with AIO_ runtime lines), then append these lines to that .env and fill them in.
# Never commit .env or paste secrets in chat.

# --- Access control -------------------------------------------------------
# Origins allowed to call the actions. Experience Workspace loads library plugins through its
# preview proxy, so the plugin runs on <branch>--<site>--<org>.preview.da.live — include it.
ALLOWED_ORIGINS=https://da.live,https://main--electrek-home--kmanns.preview.da.live,https://main--electrek-home--kmanns.aem.page,https://main--electrek-home--kmanns.aem.live
# IMS client IDs whose user tokens are accepted (Experience Workspace issues "darkalley" tokens)
IMS_ALLOWED_CLIENT_IDS=darkalley
# Optional: comma-separated IMS org IDs (xxx@AdobeOrg) allowed to use this install
IMS_ALLOWED_ORGS=
# 32 random bytes, base64 — encrypts Box tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# --- Box (OAuth 2.0 "User Authentication" app) -----------------------------
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Box app
BOX_REDIRECT_URI=https://<namespace>.adobeioruntime.net/api/v1/web/creative-commerce-studio/box-auth-callback
# Numeric ID of the campaign folder authors may browse (from the Box folder URL)
BOX_ALLOWED_FOLDER_ID=

# --- Firefly Creative Production (Workflow API, OAuth Server-to-Server) ----
# Base URL from your tenant's authenticated Workflow API reference
FFCPE_API_BASE=
FFCPE_API_VERSION=1.0
# ID of the published packshot-placement workflow
FFCPE_WORKFLOW_ID=
# Bump when you change the workflow/templates (stored on every job record)
FFCPE_RECIPE_VERSION=1
FFCPE_CLIENT_ID=
FFCPE_CLIENT_SECRET=
FFCPE_SCOPES=openid,AdobeID,session,additional_info,read_organizations,firefly_api,ff_apis
# JSON body for POST /batch/execute. Placeholders: {{workflowId}} {{sourceUrl}} {{sku}}
# {{jobId}} {{productName}} {{sourceName}}. Shape below is an EXAMPLE — confirm the
# input field names in your tenant's API reference before the first run.
FFCPE_EXECUTE_TEMPLATE={"workflowId":"{{workflowId}}","inputs":[{"name":"{{sku}}","url":"{{sourceUrl}}"}]}
# Substrings that identify the two outputs (matched against output name or URL path)
FFCPE_OUTPUT_MATCH={"desktop":"desktop","mobile":"mobile"}

# --- Product Visuals / AEM Assets (OAuth Server-to-Server with AEM API access)
AEM_AUTHOR_URL=https://author-p<program>-e<environment>.adobeaemcloud.com
AEM_DELIVERY_URL=https://delivery-p<program>-e<environment>.adobeaemcloud.com
AEM_CLIENT_ID=
AEM_CLIENT_SECRET=
AEM_SCOPES=
AEM_TARGET_FOLDER=/content/dam/creative-commerce-studio
