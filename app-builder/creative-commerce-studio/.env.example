# Creative Commerce Studio — configuration NAMES only. Run `aio app use` first (it creates
# .env with AIO_ runtime lines), then append these lines to that .env and fill them in.
# Never commit .env or paste secrets in chat.

# --- Access control -------------------------------------------------------
# Origins allowed to call the actions. Experience Workspace loads library plugins through its
# preview proxy, so the plugin runs on <branch>--<site>--<org>.preview.da.live — include it.
ALLOWED_ORIGINS=https://da.live,https://main--electrek-home--kmanns.preview.da.live,https://main--electrek-home--kmanns.aem.page,https://main--electrek-home--kmanns.aem.live
# IMS client IDs whose user tokens are accepted (Experience Workspace issues "darkalley" tokens)
IMS_ALLOWED_CLIENT_IDS=darkalley
# Optional: comma-separated IMS org IDs (xxx@AdobeOrg) allowed to use this install
IMS_ALLOWED_ORGS=
# 32 random bytes, base64 — encrypts Box tokens at rest (openssl rand -base64 32)
TOKEN_ENCRYPTION_KEY=

# --- Box (OAuth 2.0 "User Authentication" app) -----------------------------
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Box app
BOX_REDIRECT_URI=https://<namespace>.adobeioruntime.net/api/v1/web/creative-commerce-studio/box-auth-callback
# Numeric ID of the campaign folder authors may browse (from the Box folder URL)
BOX_ALLOWED_FOLDER_ID=

# --- Google Drive (Google Cloud OAuth client, type "Web application") -----
# Optional: leave empty to offer Box only.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of the Google OAuth client
GDRIVE_REDIRECT_URI=https://<namespace>.adobeioruntime.net/api/v1/web/creative-commerce-studio/gdrive-auth-callback
# Folder ID from the Drive folder URL (https://drive.google.com/drive/folders/<ID>)
GDRIVE_ALLOWED_FOLDER_ID=

# --- Firefly Creative Production -----------------------------------------
# bridge: DEMO ONLY. The local bridge (npm run bridge) on the operator's computer runs jobs
#   with the operator's own Adobe sign-in. See PRODUCTION-READINESS.md.
# api: PRODUCTION. Server-to-server credential for the REST Workflow API (needs Developer
#   access in the Firefly org); fill the FFCPE_CLIENT_*/FFCPE_IMS_* values below.
# mcp: hosted per-author sign-in. Currently refused by Adobe (only local tools may sign in).
FFCPE_MODE=bridge
# bridge mode: shared secret between the backend and the local bridge (32+ random chars)
BRIDGE_TOKEN=
# bridge mode: read only by the local bridge script
CCS_BACKEND_URL=https://<namespace>.adobeioruntime.net/api/v1/web/creative-commerce-studio
FFCPE_MCP_URL=https://run-workflow.adobe.io/mcp
# Must be this backend's firefly-auth-callback action URL
FIREFLY_REDIRECT_URI=https://<namespace>.adobeioruntime.net/api/v1/web/creative-commerce-studio/firefly-auth-callback
FIREFLY_CLIENT_NAME=Creative Commerce Studio
# Optional OAuth scope string, only if the sign-in server asks for one
FIREFLY_SCOPE=
# MCP tool names (resolved by suffix if the server prefixes them)
FFCPE_TOOL_SUBMIT=run_workflow_submit
FFCPE_TOOL_STATUS=run_workflow_get_status
# Published workflow and its node IDs (from the workflow / Execute Graph snippet)
FFCPE_WORKFLOW_ID=ddcda008-3dd4-4d28-875b-dc8148fbc814
FFCPE_PRODUCT_NODE_ID=node_1794411704_fb137ab0
FFCPE_DESKTOP_NODE_ID=node_1794411704_f56712fd
FFCPE_MOBILE_NODE_ID=node_1794411704_a75476e0
# Bump when you change the workflow (stored on every job record)
FFCPE_RECIPE_VERSION=1
# api mode only:
FFCPE_API_BASE=https://run-workflow.adobe.io
FFCPE_IMS_ORG_ID=
FFCPE_IMS_USER_ID=
FFCPE_CLIENT_ID=
FFCPE_CLIENT_SECRET=
FFCPE_SCOPES=openid,AdobeID,session,additional_info,read_organizations,firefly_api,ff_apis
# Optional override of the /batch/execute body (default mirrors the Execute Graph snippet).
# Placeholders: {{workflowId}} {{productNodeId}} {{sourceUrl}} {{sku}} {{jobId}} {{productName}} {{sourceName}}
FFCPE_EXECUTE_TEMPLATE=

# --- Delivery of approved images -------------------------------------------
# aem: Product Visuals (needs the AEM_* credential below)
# public: App Builder public storage — durable public URL, no extra credential
# (empty: aem when AEM_AUTHOR_URL is set, otherwise public)
DELIVERY_MODE=public

# --- Product Visuals / AEM Assets (OAuth Server-to-Server with AEM API access)
AEM_AUTHOR_URL=https://author-p<program>-e<environment>.adobeaemcloud.com
AEM_DELIVERY_URL=https://delivery-p<program>-e<environment>.adobeaemcloud.com
AEM_CLIENT_ID=
AEM_CLIENT_SECRET=
AEM_SCOPES=
AEM_TARGET_FOLDER=/content/dam/creative-commerce-studio
